---
layout: layouts/base.njk
---

<article class="post">
  <header class="post__header">
    <a class="post__back" href="/">← 返回文章列表</a>
    <h1>{{ title | escape }}</h1>
    <div class="post-meta">
      <time datetime="{{ date | htmlDate }}">{{ date | displayDate }}</time>
      {% if tags and tags.length %}
        <span aria-hidden="true">·</span>
        <span class="post-tags">
          {% for tag in tags %}
            <a class="post-tag" href="{{ tag | tagUrl }}">{{ tag | escape }}</a>
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </header>

  <div class="post__content">
    {{ content | safe }}
  </div>
</article>

{% set previousPost = collections.posts | getPreviousCollectionItem(page) %}
{% set nextPost = collections.posts | getNextCollectionItem(page) %}
{% if previousPost or nextPost %}
  <nav class="article-nav" aria-label="相邻文章">
    {% if previousPost %}
      <a class="article-nav__link article-nav__link--previous" href="{{ previousPost.url }}">
        <span class="article-nav__label">← 上一篇</span>
        <strong>{{ previousPost.data.title | escape }}</strong>
      </a>
    {% else %}
      <span></span>
    {% endif %}

    {% if nextPost %}
      <a class="article-nav__link article-nav__link--next" href="{{ nextPost.url }}">
        <span class="article-nav__label">下一篇 →</span>
        <strong>{{ nextPost.data.title | escape }}</strong>
      </a>
    {% endif %}
  </nav>
{% endif %}
