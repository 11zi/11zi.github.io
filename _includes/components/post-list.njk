{% if listing.heading %}
  <header class="listing-header">
    <h1>{{ listing.heading | escape }}</h1>
    <p>{{ listing.posts | length }} 篇显示在当前页</p>
  </header>
{% endif %}

<div class="post-list">
  {% for post in listing.posts %}
    <article class="post-card">
      <h2 class="post-card__title">
        <a href="{{ post.url }}">{{ post.data.title | escape }}</a>
      </h2>
      <div class="post-meta">
        <time datetime="{{ post.date | htmlDate }}">{{ post.date | displayDate }}</time>
        {% if post.data.tags and post.data.tags.length %}
          <span aria-hidden="true">·</span>
          <span class="post-tags">
            {% for tag in post.data.tags %}
              <a class="post-tag" href="{{ tag | tagUrl }}">{{ tag | escape }}</a>
            {% endfor %}
          </span>
        {% endif %}
      </div>
      {% if post.data.excerpt %}
        <p class="post-card__excerpt">{{ post.data.excerpt | escape }}</p>
      {% endif %}
    </article>
  {% endfor %}
</div>

{% if listing.totalPages > 1 %}
  <nav class="pagination" aria-label="文章分页">
    {% if listing.previousUrl %}
      <a class="pagination__edge" href="{{ listing.previousUrl }}">← 上一页</a>
    {% else %}
      <span class="pagination__edge is-disabled">← 上一页</span>
    {% endif %}

    <span class="pagination__numbers">
      {% for item in listing.pages %}
        {% if item.number == listing.pageNumber %}
          <span class="pagination__number is-current" aria-current="page">{{ item.number }}</span>
        {% else %}
          <a class="pagination__number" href="{{ item.url }}">{{ item.number }}</a>
        {% endif %}
      {% endfor %}
    </span>

    {% if listing.nextUrl %}
      <a class="pagination__edge" href="{{ listing.nextUrl }}">下一页 →</a>
    {% else %}
      <span class="pagination__edge is-disabled">下一页 →</span>
    {% endif %}
  </nav>
{% endif %}
